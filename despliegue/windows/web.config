<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS como proxy inverso hacia el servicio de MetaFlotPy (waitress en
  127.0.0.1:8000, instalado con instalar-servicio.ps1).

  Requiere el módulo Application Request Routing (ARR) con el proxy
  habilitado y el módulo URL Rewrite:

      Administrador de IIS → servidor → Application Request Routing Cache
      → Server Proxy Settings → marcar "Enable proxy"

  Coloca este archivo en la raíz del sitio de IIS.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Todo el tráfico va al servicio local -->
        <rule name="MetaFlotPy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
      <outboundRules>
        <!-- Evita que IIS reescriba las URLs absolutas de la aplicación -->
        <preConditions>
          <preCondition name="EsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- Coincide con MAX_CONTENT_LENGTH de la aplicación (2 MB) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2097152" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
