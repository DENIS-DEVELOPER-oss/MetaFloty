# Copia este archivo a .env y ajusta los valores.
# Genera la clave con:  python -c "import secrets; print(secrets.token_hex(32))"

METAFLOTPY_ENTORNO=produccion
METAFLOTPY_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres

# Solo para ejecución local con main.py
METAFLOTPY_HOST=127.0.0.1
METAFLOTPY_PORT=5000
METAFLOTPY_DEBUG=0
